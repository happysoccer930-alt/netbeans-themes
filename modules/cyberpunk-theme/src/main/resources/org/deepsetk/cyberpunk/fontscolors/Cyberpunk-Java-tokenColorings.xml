<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontscolors PUBLIC "-//NetBeans//DTD Editor Fonts and Colors settings 1.1//EN" "https://netbeans.apache.org/dtds/EditorFontsColors-1_1.dtd">
<!--
  Cyberpunk - colores especificos de Java.
  Tipos en arena, metodos en azul acero, campos en lavanda, numeros en ambar
  y cadenas en verde salvia: todos desaturados.
-->
<fontscolors>
    <fontcolor name="character" default="char"/>
    <fontcolor name="character-escape" default="character"><font style="bold"/></fontcolor>
    <fontcolor name="character-escape-invalid" default="character"><font style="italic"/></fontcolor>
    <fontcolor name="comment" default="comment"/>
    <fontcolor name="html-tag" default="comment" foreColor="ffaac6de"><font style="italic"/></fontcolor>
    <fontcolor name="identifier" default="identifier"/>
    <fontcolor name="javadoc-first-sentence" default="comment"/>
    <fontcolor name="javadoc-identifier" default="comment" foreColor="ff88a0cb"/>
    <fontcolor name="javadoc-tag" default="comment"><font style="bold"/></fontcolor>
    <fontcolor name="keyword" default="keyword"/>
    <fontcolor name="keyword-directive" default="keyword"/>
    <fontcolor name="literal" default="keyword"/>
    <fontcolor name="mod-abstract"><font style="italic"/></fontcolor>
    <fontcolor name="mod-annotation-type" default="identifier" foreColor="ffa4b9dd"/>
    <fontcolor name="mod-annotation-type-declaration" default="identifier" foreColor="ffa4b9dd"><font style="bold"/></fontcolor>
    <fontcolor name="mod-class" default="identifier" foreColor="ffa4b9dd"/>
    <fontcolor name="mod-class-declaration" default="identifier" foreColor="ffa4b9dd"><font style="bold"/></fontcolor>
    <fontcolor name="mod-constructor" default="identifier" foreColor="ffa1c0db"/>
    <fontcolor name="mod-constructor-declaration" default="identifier" foreColor="ffa4b9dd"><font style="bold"/></fontcolor>
    <fontcolor name="mod-deprecated" strikeThrough="ff70cceb"/>
    <fontcolor name="mod-enum" default="identifier" foreColor="ffa4b9dd"/>
    <fontcolor name="mod-enum-declaration" default="identifier" foreColor="ffa4b9dd"><font style="bold"/></fontcolor>
    <fontcolor name="mod-field" default="field" foreColor="ffa1bdd5"/>
    <fontcolor name="mod-field-declaration" default="field" foreColor="ffa1bdd5"/>
    <fontcolor name="mod-interface" default="identifier" foreColor="ffa4b9dd"/>
    <fontcolor name="mod-interface-declaration" default="identifier" foreColor="ffa4b9dd"><font style="bold"/></fontcolor>
    <fontcolor name="mod-local-variable" default="identifier"/>
    <fontcolor name="mod-local-variable-declaration" default="identifier"/>
    <fontcolor name="mod-method" default="method"/>
    <fontcolor name="mod-method-declaration" default="method" foreColor="ffa1c0db"><font style="bold"/></fontcolor>
    <fontcolor name="mod-package-private"/>
    <fontcolor name="mod-parameter" default="identifier"/>
    <fontcolor name="mod-parameter-declaration" default="identifier"/>
    <fontcolor name="mod-private"/>
    <fontcolor name="mod-protected"/>
    <fontcolor name="mod-public"/>
    <fontcolor name="mod-record-declaration" default="identifier" foreColor="ffa4b9dd"><font style="bold"/></fontcolor>
    <fontcolor name="mod-static"><font style="italic"/></fontcolor>
    <fontcolor name="mod-unused" foreColor="ff779fc2" waveUnderlined="ff70cceb"/>
    <fontcolor name="number" default="number"/>
    <fontcolor name="operator" default="operator"/>
    <fontcolor name="separator" default="separator"/>
    <fontcolor name="string" default="string"/>
    <fontcolor name="string-escape" default="string" foreColor="ff95aed9"/>
    <fontcolor name="string-escape-invalid" default="string" waveUnderlined="ffe76a74"/>
    <fontcolor name="whitespace" default="whitespace"/>
</fontscolors>
